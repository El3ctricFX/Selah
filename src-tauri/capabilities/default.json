{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "libmpv:default",
    "libmpv:allow-command",
    "libmpv:allow-init",
    "libmpv:allow-set-property",
    "libmpv:allow-get-property",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }] },
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-read-text-file",  "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-read-file",       "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-write-file",      "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-mkdir",           "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-remove",          "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-stat",            "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-exists",          "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-read-dir",        "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-rename",          "allow": [{ "path": "$HOME/**" }, { "path": "**" }] },
    { "identifier": "fs:allow-copy-file",       "allow": [{ "path": "$HOME/**" }, { "path": "**" }] }
  ]
}